@router.post("/admin-reset-user-password/{user_id}/", dependencies=[Depends(verify_token)])
def api_admin_reset_user_password(user_id: int):
    conn = get_db_connection()
    cursor = conn.cursor()
    try:
        cursor.execute("SELECT id, username, email FROM users WHERE id = %s", (user_id,))
        user = cursor.fetchone()
        if not user:
            raise HTTPException(status_code=404, detail="User not found")

        temp_password = generate_temp_password()
        hashed = hash_password(temp_password)

        cursor.execute("""
            UPDATE users
            SET password = %s, must_change_password = TRUE
            WHERE id = %s
        """, (hashed, user_id))
        conn.commit()

        return {
            "status": "success",
            "message": "Temporary password generated. Share it with the user securely.",
            "temp_password": temp_password,
            "username": user[1],
            "email": user[2] or ""
        }
    except HTTPException:
        raise
    except Exception as e:
        conn.rollback()
        raise HTTPException(status_code=500, detail=str(e))
    finally:
        cursor.close()
        conn.close()