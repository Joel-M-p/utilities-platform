        const confirmPw = document.getElementById('force_confirm_pw').value;
        const errBox = document.getElementById('forceChangeError');
        errBox.style.display = 'none';
        try {
            const r = await fetch('/tenant-change-password/', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${tenantToken}` },
                body: JSON.stringify({
                    tenant_id: parseInt(currentTenantId),
                    current_password: currentPw,
                    new_password: newPw,
                    confirm_password: confirmPw
                })
            });
