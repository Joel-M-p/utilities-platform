        }
    }

    async function tBuyUtility(type) {
        let inputId = 'elec_amount';
        if (type === 'WATER_COLD') inputId = 'water_cold_amount';
        if (type === 'WATER_HOT') inputId = 'water_hot_amount';
        
        const amount = document.getElementById(inputId).value;
        
        if (!amount || amount <= 0) { alert("Please enter a valid amount."); return; }

        try {
            const r = await fetch('/buy-utility/', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${tenantToken}` },
                body: JSON.stringify({
                    tenant_id: parseInt(currentTenantId),
                    utility_type: type,
                    amount: parseFloat(amount),
                    idempotency_key: crypto.randomUUID()
                })
            });
            const d = await r.json();
            if (!r.ok) throw new Error(d.detail || "Purchase failed");
            
            alert(d.message);
            tLogAction("Bought Utility", `Tenant: ${currentTenantId} bought R${amount} of ${type}. Token: ${d.token || 'N/A'}`);
            
            document.getElementById(inputId).value = '';
            tLoadDashboard();
            tLoadTransactions();
        } catch (e) {
            alert("Error: " + e.message);
        }
    }

