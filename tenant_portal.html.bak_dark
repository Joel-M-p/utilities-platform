                body: JSON.stringify({
                    tenant_id: parseInt(currentTenantId),
                    amount: parseFloat(amount),
                    idempotency_key: crypto.randomUUID()
                })
            });
            const d = await r.json();
            if (!r.ok) throw new Error(d.detail || "Payment failed");
            
